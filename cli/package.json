{
  "name": "@walkcroach/cli",
  "version": "0.2.0",
  "description": "WalkCroach CLI \u2014 a memory-first coding agent in your terminal, sharing one CockroachDB memory layer with the WalkCroach web app, Chrome extension and IDE extension",
  "type": "module",
  "license": "MIT",
  "author": "Conqueror Foundation",
  "homepage": "https://walkcroach.conquerorfoundation.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tolu-Orina/walkcroach.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/Tolu-Orina/walkcroach/issues"
  },
  "keywords": [
    "walkcroach",
    "ai",
    "agent",
    "cli",
    "coding-agent",
    "cockroachdb",
    "bedrock",
    "tui"
  ],
  "bin": {
    "walkcroach": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:packaged": "node scripts/test-packaged.mjs",
    "prepack": "npm run build",
    "start": "node --import tsx src/bin.ts",
    "walkcroach": "node --import tsx src/bin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.800.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^13.1.0",
    "ink": "^5.2.0",
    "react": "18.3.1"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "18.3.18",
    "@vitest/coverage-v8": "^3.2.7",
    "@walkcroach/agent-engine": "file:../packages/agent-engine",
    "@walkcroach/templates": "file:../packages/templates",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
