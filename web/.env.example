# Local development — copy to `.env.local` and adjust.
# Prod builds get these from SSM via web/buildspec.yml (CodeBuild).

# Agent harness (projects, sessions, billing, sandbox).
# Local: cd infra-backend && npm run dev  → http://localhost:3001
VITE_API_URL=http://localhost:3001

# Public SDK / IDE BFF (API keys, /v1/memory, /v1/sdk-health, IDE/CLI oauth).
# Local: cd infra-backend && npm run dev:ide  → http://localhost:3003
# Deployed shared GW: same host as VITE_API_URL (path-split to IDE Lambda).
VITE_IDE_API_URL=http://localhost:3003

# Chrome BFF (oauth session-code, chat handoff).
# Local: cd infra-backend && npm run dev:chrome → http://localhost:3002
# Prod shared GW: omit and fall back to VITE_API_URL.
VITE_CHROME_API_URL=http://localhost:3002

# Dev auth: fake Bearer dev:user:* / dev:anon:* tokens (no Cognito).
# Set to false to test in-app Cognito locally.
VITE_ALLOW_DEV_AUTH=true

# In-app Cognito (USER_PASSWORD_AUTH via cognito-idp API — no Hosted UI).
# VITE_COGNITO_CLIENT_ID=
# VITE_COGNITO_REGION=eu-west-2

# GitHub App connect (set in prod via SSM app_slug → VITE_GITHUB_APP_ENABLED=true)
# VITE_GITHUB_APP_ENABLED=true
# VITE_ALLOW_GITHUB_PAT=false

# Builder preview runtime preference: e2b | webcontainer
# VITE_SANDBOX_RUNTIME=e2b

# Desktop IDE — unsigned Windows Setup.exe (stable CloudFront URL from infra-web).
# When unset, landing "Download Desktop IDE" scrolls to #surfaces-desktop.
# After infra-web apply + publish:desktop-cdn, SSM has:
#   /walkcroach/{env}/web/desktop_download_url
# VITE_DESKTOP_DOWNLOAD_URL=https://xxxx.cloudfront.net/desktop/preview/latest/WalkCroach-Setup.exe
