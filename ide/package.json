{
  "name": "walkcroach-ide",
  "displayName": "WalkCroach IDE",
  "description": "WalkCroach agentic coding assistant — local agent, CockroachDB tools, and optional cross-surface memory via WalkCroach Web.",
  "version": "0.2.0",
  "publisher": "walkcroach",
  "private": false,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tolu-Orina/walkcroach.git"
  },
  "homepage": "https://walkcroach.rinegansolutions.com",
  "bugs": {
    "url": "https://github.com/Tolu-Orina/walkcroach/issues"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=20"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onView:walkcroach.sidebar",
    "onCommand:walkcroach.ping",
    "onCommand:walkcroach.showLatency",
    "onCommand:walkcroach.openPanel",
    "onCommand:walkcroach.configureCockroach",
    "onCommand:walkcroach.signIn",
    "onCommand:walkcroach.pasteToken",
    "onCommand:walkcroach.signOut",
    "onCommand:walkcroach.linkProject",
    "onCommand:walkcroach.unlinkProject",
    "onCommand:walkcroach.viewMirroredMemory",
    "onCommand:walkcroach.viewSharedSkills",
    "onUri"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "walkcroach",
          "title": "WalkCroach",
          "icon": "media/walkcroach-icon.svg"
        }
      ]
    },
    "views": {
      "walkcroach": [
        {
          "type": "webview",
          "id": "walkcroach.sidebar",
          "name": "WalkCroach"
        }
      ]
    },
    "commands": [
      {
        "command": "walkcroach.ping",
        "title": "Ping",
        "category": "WalkCroach"
      },
      {
        "command": "walkcroach.openPanel",
        "title": "Open Panel",
        "category": "WalkCroach"
      },
      {
        "command": "walkcroach.configureCockroach",
        "title": "Configure CockroachDB",
        "category": "WalkCroach"
      },
      {
        "command": "walkcroach.signIn",
        "title": "Sign In",
        "category": "WalkCroach"
      },
      {
        "command": "walkcroach.pasteToken",
        "title": "Paste Token",
        "category": "WalkCroach"
      },
      {
        "command": "walkcroach.signOut",
        "title": "Sign Out",
        "category": "WalkCroach"
      },
      {
        "command": "walkcroach.linkProject",
        "title": "Link Project",
        "category": "WalkCroach"
      },
      {
        "command": "walkcroach.unlinkProject",
        "title": "Unlink Project",
        "category": "WalkCroach"
      },
      {
        "command": "walkcroach.viewMirroredMemory",
        "title": "View Mirrored Memory",
        "category": "WalkCroach"
      },
      {
        "command": "walkcroach.viewSharedSkills",
        "title": "View Shared Skills",
        "category": "WalkCroach"
      },
      {
        "command": "walkcroach.showLatency",
        "title": "Show Latency Report",
        "category": "WalkCroach"
      }
    ],
    "configuration": {
      "title": "WalkCroach IDE",
      "properties": {
        "walkcroach.ide.apiBaseUrl": {
          "type": "string",
          "default": "https://api.walkcroach.rinegansolutions.com/v1",
          "description": "Base URL for the WalkCroach IDE BFF (/ide/*)."
        },
        "walkcroach.ide.webAppUrl": {
          "type": "string",
          "default": "https://walkcroach.rinegansolutions.com",
          "description": "WalkCroach Web app URL used for Sign In (shared Cognito account)."
        },
        "walkcroach.ide.cognitoClientId": {
          "type": "string",
          "default": "4bm25j5blkh9dv2pgciqhno083",
          "description": "Cognito SPA app client ID (same as WalkCroach Web)."
        },
        "walkcroach.ide.cognitoRegion": {
          "type": "string",
          "default": "eu-west-2",
          "description": "AWS region for the Cognito user pool."
        },
        "walkcroach.ide.cognitoUserPoolId": {
          "type": "string",
          "default": "eu-west-2_iKk1NYkcQ",
          "description": "Cognito user pool ID."
        },
        "walkcroach.ide.bedrockRegion": {
          "type": "string",
          "default": "eu-west-2",
          "description": "AWS region for Bedrock Runtime. Short-term Bedrock API keys only work in the region where they were created (often us-east-1). Must match that region."
        },
        "walkcroach.ide.bedrockModelId": {
          "type": "string",
          "default": "",
          "description": "Optional Bedrock model ID override. Empty uses Nova 2 Lite (global.amazon.nova-2-lite-v1:0) or BEDROCK_NOVA_MODEL_ID. Amazon Nova 1 Pro is not supported."
        },
        "walkcroach.ide.reasoningEffort": {
          "type": "string",
          "enum": [
            "",
            "low",
            "medium",
            "high"
          ],
          "enumDescriptions": [
            "Use the default (medium)",
            "Low effort — fastest, least reasoning",
            "Medium effort — default; same tier as WalkCroach Web App Builder",
            "High effort — slowest, most thorough (disables the output-token cap)"
          ],
          "default": "",
          "description": "Nova 2 Lite extended-thinking tier (always on). Empty uses medium. Off is not offered — thinking cannot be disabled."
        },
        "walkcroach.ide.mcp.allowStdio": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "Allow `.walkcroach/mcp.json` to start MCP servers by **running a program on this machine** (stdio transport).\n\nOff by default. Turning this on means a repository you clone can propose a command to run; WalkCroach still asks for explicit per-server approval, refuses commands inside the workspace, and never passes AWS/GitHub/CockroachDB credentials to them. This setting cannot be changed by a workspace — only in your user settings."
        }
      }
    }
  },
  "scripts": {
    "build:engine": "npm run build --prefix ../packages/agent-engine",
    "build:ext": "node esbuild.mjs",
    "build:webview": "node esbuild.webview.mjs",
    "build": "npm run build:engine && npm run build:ext && npm run build:webview",
    "watch": "node esbuild.mjs --watch",
    "watch:webview": "node esbuild.webview.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test:engine": "npm run test --prefix ../packages/agent-engine",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "package:vsix": "npm run build && npm run check:bundle && npm run check:publishable && npx --yes @vscode/vsce package --no-dependencies -o walkcroach-ide.vsix",
    "vscode:prepublish": "npm run build",
    "check:publishable": "node scripts/check-publishable.mjs",
    "publish:ovsx": "npm run package:vsix && npm run check:publishable && npx --yes ovsx publish walkcroach-ide.vsix"
  },
  "dependencies": {
    "@walkcroach/agent-engine": "file:../packages/agent-engine",
    "@walkcroach/sdk": "file:../packages/sdk",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/vscode": "^1.96.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "ai",
    "agent",
    "coding-assistant",
    "cockroachdb",
    "bedrock",
    "walkcroach",
    "mcp",
    "byok"
  ],
  "qna": "https://github.com/Tolu-Orina/walkcroach/issues"
}
