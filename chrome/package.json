{
  "name": "@walkcroach/chrome",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "description": "WalkCroach Chrome — Manifest V3 SME copilot extension",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "zip:prod": "node scripts/zip-prod.mjs",
    "screenshots": "node store/screenshots/capture.mjs",
    "extension-id": "node scripts/extension-id.mjs",
    "sign-profiles": "node scripts/sign-profiles.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:manifest": "vitest run --config vitest.manifest.config.ts",
    "test:coverage": "vitest run --coverage",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.326",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@wxt-dev/module-react": "^1.1.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4",
    "wxt": "^0.20.6"
  },
  "engines": {
    "node": ">=20"
  }
}
