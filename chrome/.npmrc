# `npm version <patch|minor|major>` bumps package.json, commits and tags in one
# step — but tags `v0.6.0` by default, while publish-chrome.yml triggers on
# `chrome-v*` and refuses to run if the tag and package.json disagree.
#
# With this prefix the whole release is:
#   npm version minor && git push --follow-tags
#
# WXT reads package.json version into the extension manifest, so the tag, the
# manifest and the zip filename all stay in lockstep by construction.
tag-version-prefix=chrome-v
