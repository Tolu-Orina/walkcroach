# WalkCroach Chrome — production release endpoints
#
# Used by `npm run zip:prod` (defaults match these values).
# Override via environment when pointing at another stage.

WALKCROACH_API_BASE=https://api.walkcroach.rinegansolutions.com/v1
# IDE / SDK memory API — same host in prod (optional; derived from API_BASE when unset)
# WALKCROACH_IDE_API_BASE=https://api.walkcroach.rinegansolutions.com
WALKCROACH_PRIVACY_URL=https://walkcroach.rinegansolutions.com/chrome-privacy.html
WALKCROACH_WEB_URL=https://walkcroach.rinegansolutions.com
