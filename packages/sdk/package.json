{
  "name": "@walkcroach/sdk",
  "version": "0.2.0",
  "type": "module",
  "description": "Typed client for the WalkCroach agentic memory layer — durable, tenant-scoped, provenance-preserving memory on CockroachDB",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "openapi"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "vendor:contracts": "node scripts/vendor-memory-contracts.mjs",
    "build": "npm run vendor:contracts && tsc -p tsconfig.json",
    "typecheck": "npm run vendor:contracts && tsc -p tsconfig.json --noEmit",
    "test": "npm run vendor:contracts && vitest run",
    "test:coverage": "npm run vendor:contracts && vitest run --coverage",
    "prepack": "npm run build",
    "check:openapi": "node scripts/check-openapi-drift.mjs",
    "check:memory-contracts": "node ../memory-contracts/scripts/check-memory-contracts-drift.mjs"
  },
  "keywords": [
    "agent-memory",
    "cockroachdb",
    "mcp",
    "llm",
    "vector-search",
    "provenance"
  ],
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
