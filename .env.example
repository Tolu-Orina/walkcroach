# CockroachDB
CRDB_CONNECTION_STRING=postgresql://user:password@host:26257/walkcroach?sslmode=verify-full
CRDB_MCP_URL=https://cockroachlabs.cloud/mcp
CRDB_MCP_API_KEY=

# TLS certificate verification is ON by default. CockroachDB Cloud's certificate
# is publicly trusted, so neither of these is needed there.
# Self-hosted / custom CA: inline PEM, or a path to one.
# CRDB_CA_CERT=
# Escape hatch that DISABLES verification (man-in-the-middle risk). Never in prod.
# CRDB_SSL_INSECURE=false

# Tags connections so the DB Console shows load per surface.
# WALKCROACH_SURFACE=walkcroach

# Cosine distance below which a new memory entry retires (supersedes) the nearest
# same-kind entry. 0 disables superseding and makes memory append-only again.
# MEMORY_SUPERSEDE_THRESHOLD=0.15

# AWS / Bedrock
AWS_REGION=eu-west-2
BEDROCK_NOVA_MODEL_ID=global.amazon.nova-2-lite-v1:0
BEDROCK_TITAN_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# Optional until Terraform apply publishes the chat guardrail (PROMPT_ATTACK / leakage)
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=1
# BEDROCK_GUARDRAIL_TRACE=false
# Short-term Bedrock API key from console (London / eu-west-2). Max ~12h.
AWS_BEARER_TOKEN_BEDROCK=

# App (web build-time — set by CI from SSM in deployed envs)
VITE_API_URL=http://localhost:3001

# Local API auth: accept Bearer dev:user:* / dev:anon:* (never enable in prod)
ALLOW_DEV_AUTH=true
VITE_ALLOW_DEV_AUTH=true

# Optional
S3_ARTEFACTS_BUCKET=
WALKCROACH_API_KEY=
